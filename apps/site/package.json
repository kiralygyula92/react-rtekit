{
  "name": "@react-rtekit/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4189 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:update": "playwright test --update-snapshots",
    "api:generate": "node scripts/generate-api.mjs",
    "e2e:perf": "playwright test --config=playwright.perf.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "^5.3.0",
    "@lexical/html": "^0.38.0",
    "@lexical/link": "^0.38.0",
    "@lexical/list": "^0.38.0",
    "@lexical/markdown": "^0.38.0",
    "@lexical/react": "^0.38.0",
    "@lexical/rich-text": "^0.38.0",
    "@lexical/selection": "^0.38.0",
    "@lexical/table": "^0.38.0",
    "@lexical/utils": "^0.38.0",
    "formik": "^2.4.9",
    "lexical": "^0.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-router": "^7.9.4",
    "react-rtekit": "workspace:*",
    "react-rtekit-rhf": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.12"
  }
