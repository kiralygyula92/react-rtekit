{
  "name": "@react-rtekit/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4189 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:update": "playwright test --update-snapshots",
    "api:generate": "node scripts/generate-api.mjs",
    "e2e:perf": "playwright test --config=playwright.perf.config.ts",
    "brand:assets": "node scripts/brand-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "formik": "^2.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.89.0",
    "react-router": "^8.4.0",
    "react-rtekit": "workspace:*",
    "react-rtekit-rhf": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1"
  }
}
