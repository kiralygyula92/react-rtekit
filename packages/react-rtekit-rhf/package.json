{
  "name": "react-rtekit-rhf",
  "version": "1.0.0",
  "description": "react-hook-form adapter for react-rtekit: <RteField> with isEmpty-aware required validation.",
  "keywords": [
    "react",
    "react-hook-form",
    "rich-text-editor",
    "react-rtekit",
    "form"
  ],
  "license": "MIT",
  "author": {
    "name": "kiralygyula92",
    "url": "https://github.com/kiralygyula92"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiralygyula92/react-rtekit.git",
    "directory": "packages/react-rtekit-rhf"
  },
  "homepage": "https://github.com/kiralygyula92/react-rtekit#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "size": "size-limit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-dom": ">=18.2",
    "react-hook-form": ">=7.45",
    "react-rtekit": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "publint": "^0.3.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-rtekit": "workspace:*",
    "size-limit": "^11.2.0",
    "tsup": "^8.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/kiralygyula92/react-rtekit/issues"
  }
}
