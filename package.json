{
  "name": "react-rtekit-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for react-rtekit: a production-grade React rich-text editor library.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" build",
    "build:site": "pnpm --filter @react-rtekit/site build",
    "dev": "pnpm --filter @react-rtekit/site dev",
    "clean": "pnpm -r exec rimraf dist coverage .vite && rimraf node_modules/.vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "pnpm --filter @react-rtekit/site e2e",
    "e2e:install": "playwright install --with-deps",
    "size": "pnpm --filter \"./packages/**\" size",
    "docs:json": "pnpm --filter react-rtekit docs:json",
    "docs:check": "pnpm --filter react-rtekit docs:check",
    "publint": "pnpm --filter \"./packages/**\" publint",
    "attw": "pnpm --filter \"./packages/**\" attw",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "e2e:perf": "pnpm --filter @react-rtekit/site e2e:perf"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.9",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
